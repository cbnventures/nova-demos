      "prefix": "PROJECT_"
    },
    "workspaces": {
      "./": {
        "prefix": "ROOT_"
      },
      "./apps/demo-envoy": {
        "prefix": "ENVOY_"
      },
      "./apps/demo-foundry": {
        "prefix": "FOUNDRY_"
      },
      "./apps/demo-lantern": {
        "prefix": "LANTERN_"
      },
      "./apps/demo-marshal": {
        "prefix": "MARSHAL_"
      },
      "./apps/demo-sentinel": {
        "prefix": "SENTINEL_"
      },
      "./apps/demo-signal": {
