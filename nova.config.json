  "settings": {
    "changelog": {
      "workspaceOrder": [
        "nova-demos-app-website",
        "demo-envoy",
        "demo-foundry",
        "demo-lantern",
        "demo-marshal",
        "demo-sentinel",
        "demo-signal",
        "nova-demos-tool-testkit"
      ]
    },
    "lockStepVersioning": true,
    "runWorkspaces": {
      "cache": {
        "enabled": true,
        "directory": "./node_modules/.cache/nova/run-workspaces",
        "scripts": [
          "build",
          "check"
        ]
      },
      "concurrency": {
        "build": 2,
        "check": 2,
        "deploy": 2
      }
    },
    "versionStrategy": "calver"
  }
