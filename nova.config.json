      },
      "./packages/demos-testkit": {
        "prefix": "TESTKIT_"
      },
      "./apps/website": {
        "prefix": "WEBSITE_"
      }
    },
    "workflows": {
      "sponsor-check": {
        "prefix": "SGS_"
      }
    }
