{
  "project": {
    "name": {
      "title": "Nova Demos",
      "slug": "nova-demos"
    },
    "description": {
      "short": "Live demonstration sites for the Nova Docusaurus preset family",
      "long": "Nova Demos is a collection of standalone Docusaurus sites that showcase each visual preset in the Nova family \u2014 envoy, foundry, lantern, marshal, sentinel, and signal. Each demo is a fully wired reference build you can run locally to compare presets, blocks, and theming side by side."
    },
    "keywords": [
      "nova",
      "docusaurus",
      "docusaurus-preset",
      "demo",
      "showcase",
      "presets",
      "theme",
      "documentation"
    ],
    "legalName": "CBN Ventures LLC",
    "pronouns": "business",
    "platforms": [
      "nodejs"
    ],
    "startingYear": 2026,
    "license": "MIT"
  },
  "entities": [
    {
      "name": "CBN Ventures",
      "email": "contact@cbnventures.io",
      "url": "https://www.cbnventures.io/",
      "roles": [
        "author"
      ]
    },
    {
      "name": "Jacky Liang",
      "email": "hello@mrjackyliang.com",
      "url": "https://www.mrjackyliang.com/",
      "roles": [
        "contributor",
        "supporter"
      ]
    }
  ],
  "emails": {
    "bugs": "bugs@cbnventures.io"
  },
  "github": {
    "owner": "cbnventures",
    "repo": "nova-demos",
    "topics": [
      "nova",
      "docusaurus",
      "docusaurus-preset",
      "demo",
      "showcase",
      "presets",
      "documentation"
    ],
    "features": {
      "issues": true,
      "wiki": false,
      "projects": false,
      "discussions": false
    },
    "policies": {
      "visibility": "public",
      "defaultBranch": "main",
      "mergeMethods": {
        "merge": true,
        "squash": true,
        "rebase": true
      },
      "autoDeleteHeadBranch": true
    }
  },
  "workflows": [
    {
      "template": "check-sponsor-gated-issues",
      "name": "sponsor-check",
      "triggers": [
        "issue-comment",
        "issues"
      ]
    },
    {
      "template": "lock-inactive-issues",
      "name": "lock-inactive",
      "triggers": [
        "schedule-weekly"
      ]
    }
  ],
  "urls": {
    "homepage": "https://github.com/cbnventures/nova-demos",
    "repository": "git+https://github.com/cbnventures/nova-demos.git",
    "bugs": "https://github.com/cbnventures/nova-demos/issues",
    "license": "https://github.com/cbnventures/nova-demos/blob/HEAD/LICENSE",
    "logo": "https://nova.cbnventures.io/images/logo.svg",
    "documentation": "https://nova.cbnventures.io/",
    "fundSources": [
      "https://github.com/sponsors/cbnventures",
      "https://www.paypal.com/biz/profile/cbnventures"
    ],
    "privacyPolicy": "https://www.cbnventures.io/privacy/",
    "termsOfUse": "https://www.cbnventures.io/terms/"
  },
