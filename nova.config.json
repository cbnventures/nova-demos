  "workflows": [
    {
      "template": "check-sponsor-gated-issues",
      "name": "sponsor-check",
      "triggers": [
        "issue-comment",
        "issues"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "lock-inactive-issues",
      "name": "lock-inactive",
      "triggers": [
        "schedule-weekly"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "publish",
      "name": "project",
      "triggers": [
        {
          "name": "tag-push",
          "tags": [
            "[0-9]+.[0-9]+.[0-9]+"
          ]
        }
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 30,
      "build": [
        "./apps/website"
      ],
      "deploy": [
        {
          "to": "cloudflare-pages",
          "path": "./apps/website",
          "artifact": "website"
        }
      ]
    }
  ],
  "urls": {
    "homepage": "https://nova-demos.cbnventures.io/",
    "repository": "git+https://github.com/cbnventures/nova-demos.git",
    "bugs": "https://github.com/cbnventures/nova-demos/issues",
    "license": "https://github.com/cbnventures/nova-demos/blob/HEAD/LICENSE",
