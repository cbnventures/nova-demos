{
  "project": {
    "name": {
      "title": "Nova Demos",
      "slug": "nova-demos"
    },
    "description": {
      "short": "Every Nova Docusaurus preset, live and side by side in its own demonstration site",
      "long": "Compare Nova's Docusaurus presets side by side, each running as its own standalone site. Run any demo locally as a fully wired reference build of blocks, theming, and layout."
    },
    "keywords": [
      "nova",
      "docusaurus",
      "docusaurus-preset",
      "demo",
      "showcase",
      "presets",
      "theme",
      "documentation"
    ],
    "legalName": "CBN Ventures LLC",
    "pronouns": "business",
    "platforms": [
      "nodejs",
      "web"
    ],
    "startingYear": 2026,
    "license": "MIT"
  },
  "entities": [
    {
      "name": "CBN Ventures",
      "email": "contact@cbnventures.io",
      "url": "https://www.cbnventures.io/",
      "roles": [
        "author"
      ]
    },
    {
      "name": "Jacky Liang",
      "email": "hello@mrjackyliang.com",
      "url": "https://www.mrjackyliang.com/",
      "roles": [
        "contributor",
        "supporter"
      ]
    }
  ],
  "emails": {
    "bugs": "bugs@cbnventures.io"
  },
  "github": {
    "owner": "cbnventures",
    "repo": "nova-demos",
    "topics": [
      "nova",
      "docusaurus",
      "docusaurus-preset",
      "demo",
      "showcase",
      "presets",
      "documentation"
    ],
    "features": {
      "issues": true,
      "wiki": false,
      "projects": false,
      "discussions": false,
      "sponsorships": true
    },
    "policies": {
      "visibility": "public",
      "defaultBranch": "main",
      "mergeMethods": {
        "merge": true,
        "squash": true,
        "rebase": true
      },
      "mergeCommit": {
        "title": "merge-message",
        "message": "pull-request-title"
      },
      "squashMerge": {
        "title": "commit-or-pull-request-title",
        "message": "commit-messages"
      },
      "autoDeleteHeadBranch": true,
      "autoMerge": false,
      "allowUpdateBranch": false,
      "webCommitSignoffRequired": false
    },
    "security": {
      "vulnerabilityAlerts": true,
      "dependabotSecurityUpdates": false,
      "secretScanning": true,
      "pushProtection": true
    },
    "rulesets": {
      "defaultBranch": {
        "enforcement": "active",
        "blockDeletions": true,
        "blockForcePushes": true,
        "requireLinearHistory": false,
        "requireSignedCommits": true,
        "requirePullRequest": false,
        "requiredStatusChecks": [],
        "requireBranchesToBeUpToDate": false
      }
    },
    "actions": {
      "enabled": true,
      "allowedActions": "all",
      "shaPinningRequired": false,
      "defaultWorkflowPermissions": "read",
      "canApprovePullRequestReviews": false,
      "artifactRetentionDays": 7
    },
    "labels": [
      {
        "name": "bug",
        "color": "d73a4a",
        "description": "Something isn't working"
      },
      {
        "name": "documentation",
        "color": "0075ca",
        "description": "Improvements or additions to documentation"
      },
      {
        "name": "duplicate",
        "color": "cfd3d7",
        "description": "This issue or pull request already exists"
      },
      {
        "name": "enhancement",
        "color": "a2eeef",
        "description": "New feature or request"
      },
      {
        "name": "good first issue",
        "color": "7057ff",
        "description": "Good for newcomers"
      },
      {
        "name": "help wanted",
        "color": "008672",
        "description": "Extra attention is needed"
      },
      {
        "name": "invalid",
        "color": "e4e669",
        "description": "This doesn't seem right"
      },
      {
        "name": "question",
        "color": "d876e3",
        "description": "Further information is requested"
      },
      {
        "name": "wontfix",
        "color": "ffffff",
        "description": "This will not be worked on"
      }
    ],
    "issueTemplate": {
      "bugReportFields": [
        "web",
        "screenshots"
      ],
      "customQuestions": {
        "bug": [
          {
            "type": "dropdown",
            "id": "demo-preset",
            "attributes": {
              "label": "Demo Preset",
              "description": "Select the affected demo preset.",
              "options": [
                "Envoy",
                "Foundry",
                "Lantern",
                "Marshal",
                "Sentinel",
                "Signal",
                "All Demos"
              ]
            },
            "validations": {
              "required": true
            }
          },
          {
            "type": "dropdown",
            "id": "page-type",
            "attributes": {
              "label": "Page Type",
              "description": "Select the affected demo page.",
              "options": [
                "Homepage",
                "Documentation",
                "Versioned Documentation",
                "Blog",
                "Showcase",
                "Search",
                "Navigation",
                "Error Page",
                "Bare Mode",
                "Repository Website",
                "Other"
              ]
            },
            "validations": {
              "required": false
            }
          }
        ],
        "feature": [
          {
            "type": "dropdown",
            "id": "demo-preset",
            "attributes": {
              "label": "Demo Preset",
              "description": "Select the affected demo preset.",
              "options": [
                "Envoy",
                "Foundry",
                "Lantern",
                "Marshal",
                "Sentinel",
                "Signal",
                "All Demos"
              ]
            },
            "validations": {
              "required": true
            }
          },
          {
            "type": "dropdown",
            "id": "page-type",
            "attributes": {
              "label": "Page Type",
              "description": "Select the affected demo page.",
              "options": [
                "Homepage",
                "Documentation",
                "Versioned Documentation",
                "Blog",
                "Showcase",
                "Search",
                "Navigation",
                "Error Page",
                "Bare Mode",
                "Repository Website",
                "Other"
              ]
            },
            "validations": {
              "required": false
            }
          }
        ],
        "support": [
          {
            "type": "dropdown",
            "id": "demo-preset",
            "attributes": {
              "label": "Demo Preset",
              "description": "Select the affected demo preset.",
              "options": [
                "Envoy",
                "Foundry",
                "Lantern",
                "Marshal",
                "Sentinel",
                "Signal",
                "All Demos"
              ]
            },
            "validations": {
              "required": true
            }
          }
        ]
      }
    }
